# Vorlage fuer die lokale Datei .env (welche NICHT eingecheckt wird).
# Kopieren:  cp .env.example .env   und Werte eintragen.
#
# Wird von Packaging/git_setup.sh gelesen, um das private GitHub-Repo
# anzulegen und zu pushen.

GITHUB_USER=auximalia
GITHUB_REPO=activities
GITHUB_PRIVATE=true

# Persoenlicher Access Token mit 'repo'-Scope:
GITHUB_TOKEN=ghp_dein_token_hier

# Optional: fuer Packaging/notarize.sh (Apple Developer Program noetig)
# DEVELOPER_ID_APP=Developer ID Application: Dein Name (TEAMID)
# APPLE_ID=deine@apple-id.example
# APPLE_TEAM_ID=XXXXXXXXXX
# APPLE_APP_PASSWORD=abcd-efgh-ijkl-mnop
